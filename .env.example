# Copy to .env for Docker Compose. Never commit actual credentials.
DB_PASSWORD=replace-with-your-local-development-password
DB_ROOT_PASSWORD=replace-with-a-different-local-development-password
APP_PORT=8080
APP_TIMEZONE=Asia/Taipei
# Off by default. Set to 1 only for a local demonstration, never as a payment flow.
ENABLE_DEMO_TOPUP=0
